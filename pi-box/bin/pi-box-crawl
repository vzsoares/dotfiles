#!/usr/bin/env python3
"""Breadth-first crawl of one site into markdown files.

usage: pi-box-crawl URL [--depth N] [--out DIR]

Env defaults: CRAWL_DELAY_MS=1000, CRAWL_CONCURRENCY=2, CRAWL_MAX_PAGES=500,
CRAWL_RESPECT_ROBOTS=0, CRAWL_USER_AGENT. Writes DIR/NNNN.md per page and
DIR/index.jsonl (url, status, file). Stays on the start URL's domain.
"""
import argparse
import asyncio
import json
import os
from pathlib import Path

from crawl4ai import AsyncWebCrawler, BrowserConfig, CrawlerRunConfig
from crawl4ai.deep_crawling import BFSDeepCrawlStrategy

UA = "Mozilla/5.0 (compatible; pi-box/1.0)"


async def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("url")
    ap.add_argument("--depth", type=int, default=1)
    ap.add_argument("--out", default="out/crawl")
    args = ap.parse_args()

    delay = int(os.environ.get("CRAWL_DELAY_MS", "1000")) / 1000
    conc = int(os.environ.get("CRAWL_CONCURRENCY", "2"))
    max_pages = int(os.environ.get("CRAWL_MAX_PAGES", "500"))
    robots = os.environ.get("CRAWL_RESPECT_ROBOTS", "0") == "1"
    ua = os.environ.get("CRAWL_USER_AGENT", UA)

    out = Path(args.out)
    out.mkdir(parents=True, exist_ok=True)
    cfg = CrawlerRunConfig(
        deep_crawl_strategy=BFSDeepCrawlStrategy(
            max_depth=args.depth,
            # The strategy drops the page that reaches its cap; our loop stops at max_pages.
            max_pages=max_pages + 1,
            include_external=False,
        ),
        stream=True,
        check_robots_txt=robots,
        user_agent=ua,
        semaphore_count=conc,
        mean_delay=delay,
        max_range=0,
    )
    n = 0
    with (out / "index.jsonl").open("w") as index:
        async with AsyncWebCrawler(config=BrowserConfig(user_agent=ua)) as crawler:
            async for r in await crawler.arun(args.url, config=cfg):
                if n >= max_pages:
                    break
                name = f"{n + 1:04d}.md"
                if r.success:
                    n += 1
                    (out / name).write_text(str(r.markdown), encoding="utf-8")
                row = {
                    "url": r.url,
                    "status": r.status_code,
                    "file": name if r.success else None,
                    "error": None if r.success else r.error_message,
                }
                index.write(json.dumps(row) + "\n")
                print(f"{row['status']} {r.url}")
    print(f"{n} pages -> {out}")
    return 0 if n else 1


raise SystemExit(asyncio.run(main()))
