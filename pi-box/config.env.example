# pi-box defaults, copied to ~/pi-box/config.env by pi-box/link.
# No secrets: the model key comes from the host env, never from here.
# Any of these set in the host env overrides this file for one run.
CRAWL_DELAY_MS=1000
CRAWL_CONCURRENCY=2
CRAWL_MAX_PAGES=500
CRAWL_RESPECT_ROBOTS=0
CRAWL_USER_AGENT="Mozilla/5.0 (compatible; pi-box/1.0)"
# HTTP_PROXY=
# HTTPS_PROXY=
# ALL_PROXY=
# NO_PROXY=
# Monthly spend cap (USD) across box models; see pi-box cost.
# PIBOX_CAP_USD=10
# PIBOX_WARN_PCT=80
# Held against the cap for each start, and charged for a message whose cost is unknown.
# PIBOX_CALL_RESERVE_USD=0.10
