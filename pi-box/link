#!/usr/bin/env bash
# Creates the ~/pi-box workspace. Agent templates and config.env are copied,
# not linked: the repo is not mounted in the box, and pi rewrites settings.json.
# Existing files are kept; pass --force to overwrite the agent templates.
# mcp.json keeps the servers pi added; only its `browser` entry is set.
# Skills, including the shared pi skill, are repo-owned and always refreshed.

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$HOME/pi-box"

for d in "$ROOT" "$ROOT/work" "$ROOT/in" "$ROOT/in/cookies" "$ROOT/agent" \
  "$ROOT/agent/skills" "$ROOT/shim"; do
  if [ -L "$d" ]; then
    echo "pi-box/link: $d is a symlink; the wrapper refuses it" >&2
    exit 1
  fi
  mkdir -p "$d"
done

copy() { # src, dest
  if [ -e "$2" ] && [ "${FORCE:-}" != 1 ]; then
    echo "kept   $2"
  else
    cp "$1" "$2"
    echo "copied $2"
  fi
}

[ "${1:-}" = --force ] && FORCE=1
for f in AGENTS.md settings.json models.json; do
  copy "$SCRIPT_DIR/agent/$f" "$ROOT/agent/$f"
done

MCP="$ROOT/agent/mcp.json"
if [ "${FORCE:-}" = 1 ] || { [ ! -e "$MCP" ] && [ ! -L "$MCP" ]; }; then
  # The box can write this dir: rename over the path, never write through it.
  tmp="$(mktemp "$ROOT/agent/.mcp.json.XXXXXX")"
  cp "$SCRIPT_DIR/agent/mcp.json" "$tmp"
  chmod 644 "$tmp"
  mv -f "$tmp" "$MCP"
  echo "copied $MCP"
else
  python3 - "$SCRIPT_DIR/agent/mcp.json" "$MCP" <<'PY'
import json
import os
import stat
import sys
import tempfile

template, path = sys.argv[1:3]


def fail(msg):
    print(f"pi-box/link: {path} {msg}", file=sys.stderr)
    sys.exit(1)


with open(template) as f:
    entry = json.load(f)["mcpServers"]["browser"]
try:
    # The box can write this dir: never follow a link or block on a fifo.
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
except OSError:
    fail("is a symlink or unreadable; remove it")
with os.fdopen(fd) as f:
    if not stat.S_ISREG(os.fstat(f.fileno()).st_mode):
        fail("is not a regular file; remove it")
    try:
        data = json.load(f)
    except ValueError:
        fail("is not valid JSON; fix it or pass --force")
servers = data.setdefault("mcpServers", {}) if isinstance(data, dict) else None
if not isinstance(servers, dict):
    fail("has no mcpServers object; fix it or pass --force")
servers["browser"] = entry
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".mcp.json.")
with os.fdopen(fd, "w") as f:
    json.dump(data, f, indent=4)
    f.write("\n")
os.chmod(tmp, 0o644)
os.replace(tmp, path)
PY
  echo "merged $MCP"
fi
for skill in "$SCRIPT_DIR"/skills/*/; do
  name="$(basename "$skill")"
  mkdir -p "$ROOT/agent/skills/$name"
  cp "$skill/SKILL.md" "$ROOT/agent/skills/$name/SKILL.md"
  echo "copied $ROOT/agent/skills/$name/SKILL.md"
done
PI_SKILL="$ROOT/agent/skills/pi"
rm -rf "$PI_SKILL"
cp -R "$SCRIPT_DIR/../.claude/skills/pi" "$PI_SKILL"
find "$PI_SKILL" -name __pycache__ -prune -exec rm -rf {} +
echo "copied $PI_SKILL"
FORCE='' copy "$SCRIPT_DIR/config.env.example" "$ROOT/config.env"

ln -sfn "$SCRIPT_DIR/wrapper" "$ROOT/shim/pi"
echo "linked $ROOT/shim/pi"

# agent-manager launches pi through the profile's PATH, so the shim wins.
# The profile stores PATH as a literal: re-run after PATH changes.
if command -v agent-manager >/dev/null; then
  path=":$PATH:"
  for shim in "$ROOT/shim" "$ROOT/shim/"; do
    while [[ "$path" = *":$shim:"* ]]; do
      path="${path//:$shim:/:}"
    done
  done
  path="${path#:}"
  agent-manager env set pi-box "PATH=$ROOT/shim:${path%:}" \
    "PI_CODING_AGENT_DIR=$ROOT/agent" >/dev/null
  echo "set agent-manager env profile pi-box"
  if ! agent-manager groups --json | grep -q '"path": *"pi-box"'; then
    agent-manager create-group pi-box --directory "$ROOT/work" >/dev/null
    echo "created agent-manager group pi-box"
  fi
fi

echo "next: pi-box build   (then: mkdir -p $ROOT/work/<id> && cd there && pi-box)"
