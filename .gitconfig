[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
[user]
	email = vinicius.zenha@gmail.com
	name = vzsoares
[credential]
	helper = store
[core]
	editor = nvim
	; pre-push gates prod/main/master on a zen-inbox ask; other names run the repo's own hooks
	hooksPath = ~/code/personal/dotfiles/git/hooks
[init]
	defaultBranch = main
[merge]
	ff = no
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[status]
	; list untracked files individually instead of collapsing them into "dir/".
	; a collapsed dir makes fugitive's <CR> edit a directory path, which nvim-tree
	; hijacks and swaps in over the status window
	showUntrackedFiles = all
