#!/bin/bash
# Scans the pushed commits for secrets first (git/secret-scan.sh), then gates
# every push to prod/main/master: an agent push, a force push or a delete needs
# an approved, unused `zen-inbox ask --prod push` for that repo, branch and
# sha, or a zen-release approval's one push; a human at a tty confirms a plain
# create or update with gum. The repo's own pre-push runs before the consume,
# so its failure leaves the approval unused. A guard rail, not a boundary:
# --no-verify skips it.
# A release push passes on its approval only if the remote tip is behind the
# approved sha and the pushed sha adds just CHANGELOG.md and the root package
# version in the files zen-release bumps (parsed, not pattern-matched). A
# hotfix-on-target release, where the target branch has commits the approved
# sha lacks, is refused; the fallback is a --prod push ask for the exact tip.
# Known limit: git push --dry-run runs this hook too, so it consumes.
set -e

zen_say() { echo "pre-push: $*" >&2; }

input=$(
	cat
	echo .
)
input=${input%.}

common=$(git rev-parse --path-format=absolute --git-common-dir)
repo=$(basename "$(dirname "$common")")
bypass="run it yourself with git push --no-verify"

refuse() {
	zen_say "$*"
	exit 1
}

hook="$common/hooks/pre-push"
repo_hook() {
	if [ -x "$hook" ] && ! [ "$hook" -ef "$0" ]; then
		"$hook" "$@" < <(printf '%s' "$input")
	fi
}

# $1 class, $2 branch, $3 local sha, $4 remote sha
ask_line() {
	local context=""
	case $1 in
	force) context=" --context \"force push over ${4:0:12}\"" ;;
	delete) context=" --context \"delete $2 at ${4:0:12}\"" ;;
	esac
	echo "  zen-inbox ask <task> --prod push --repo $repo --branch $2 --sha $3$context" >&2
}

zero() { [ -z "${1//0/}" ]; }

src=$0
while [ -L "$src" ]; do
	link=$(readlink "$src")
	case $link in
	/*) src=$link ;;
	*) src=$(dirname "$src")/$link ;;
	esac
done
zen_git=$(cd -P "$(dirname "$src")/.." && pwd)
# shellcheck source=git/secret-scan.sh
. "$zen_git/secret-scan.sh"
secret_scan "$@"

# Runs zen-inbox into $out; returns 0, 1, or 5 when it is missing or failed
# for any other reason (go, vault or db unavailable).
inbox() {
	if ! command -v zen-inbox >/dev/null 2>&1; then
		out="zen-inbox not found on PATH"
		return 5
	fi
	local rc=0
	out=$(zen-inbox "$@" 2>&1) || rc=$?
	case $rc in
	0 | 1) return $rc ;;
	*)
		out="zen-inbox exited $rc: $out"
		return 5
		;;
	esac
}

# Same rule as zen-inbox's guard: an agent binary, its install dir or npm
# package, also as a runtime's script; the agentmgr tmux server counts too.
agent_in() {
	local exe f fields
	read -ra fields <<<"$1"
	[ ${#fields[@]} -gt 0 ] || return 1
	exe=${fields[0]#-}
	case ${exe##*/} in
	node | bun | deno) fields=("$exe" "${fields[@]:1}") ;;
	tmux)
		for f in "${fields[@]}"; do
			case $f in -Lagentmgr) return 0 ;; esac
		done
		case " ${fields[*]} " in *" -L agentmgr "*) return 0 ;; esac
		fields=("$exe")
		;;
	*) fields=("$exe") ;;
	esac
	for f in "${fields[@]}"; do
		case ${f##*/} in
		claude | claude-code | codex) return 0 ;;
		esac
		case /$f/ in
		*/claude/versions/* | */@anthropic-ai/claude-code/* | */@openai/codex/*) return 0 ;;
		esac
	done
	return 1
}

# Prints why this push comes from an agent: an agent env var, or an agent in
# the process tree, which survives an unset env. Fails closed.
agent_reason() {
	local v pid=$$ depth=0 line ppid args
	for v in AGENT_MANAGER_SESSION_ID AGENT_MANAGER_AGENT_PID CLAUDECODE; do
		if [ -n "${!v}" ]; then
			echo "$v is set"
			return 0
		fi
	done
	while [ "$pid" -gt 1 ]; do
		if [ $((depth += 1)) -gt 256 ]; then
			echo "process tree deeper than 256"
			return 0
		fi
		if ! line=$(ps -o ppid=,args= -p "$pid" 2>/dev/null) || [ -z "$line" ]; then
			echo "process tree unreadable at pid $pid"
			return 0
		fi
		read -r ppid args <<<"$line"
		case $ppid in
		'' | *[!0-9]*)
			echo "process tree unreadable at pid $pid"
			return 0
			;;
		esac
		if agent_in "$args"; then
			echo "inside ${args%% *} (pid $pid)"
			return 0
		fi
		pid=$ppid
	done
	return 1
}

# One line per gated ref: class branch local-sha remote-sha, where class is
# create, update, force (remote sha not an ancestor, or unknown here) or delete.
gated=""
while read -r _ lsha rref rsha; do
	case $rref in
	refs/heads/prod | refs/heads/main | refs/heads/master) ;;
	*) continue ;;
	esac
	[ "$lsha" = "$rsha" ] && continue
	if zero "$lsha"; then
		class=delete
	elif zero "$rsha"; then
		class=create
	elif git merge-base --is-ancestor "$rsha" "$lsha^{commit}" 2>/dev/null; then
		class=update
	else
		class=force
	fi
	gated="$gated$class ${rref#refs/heads/} $lsha $rsha
"
done <<EOF
$input
EOF

[ -n "$gated" ] || {
	repo_hook "$@"
	exit 0
}

# $1 approved sha, $2 pushed sha, $3 remote sha: true when the remote tip is
# behind the approved sha (no rollback to old approved content), the pushed sha
# descends from it, and between them only CHANGELOG.md and the root package
# version of the files zen-release bumps change.
release_fits() {
	local meta path old new status
	zero "$3" || git merge-base --is-ancestor "$3" "$1" 2>/dev/null || return 1
	git merge-base --is-ancestor "$1" "$2" 2>/dev/null || return 1
	while IFS= read -r -d '' meta && IFS= read -r -d '' path; do
		read -r old new _ _ status <<<"${meta#:}"
		[ "$new" = 100644 ] || return 1
		if [ "$path" = CHANGELOG.md ]; then
			case $status in M | A) continue ;; esac
			return 1
		fi
		[ "$old" = 100644 ] && [ "$status" = M ] || return 1
		version_lines "$1" "$2" "$path" || return 1
	done < <(git diff --raw -z --no-renames --no-abbrev "$1" "$2")
}

# $3 changed between $1 and $2 in nothing but the root package's own version,
# judged on the parsed file (git/release-fits.py); a parse error fails.
version_lines() {
	case $3 in
	package.json | package-lock.json | pyproject.toml | Cargo.toml) ;;
	*/*) case ${3##*/} in pubspec.yaml | config.py | settings.py) ;; *) return 1 ;; esac ;;
	pubspec.yaml | config.py | settings.py) ;;
	*) return 1 ;;
	esac
	local py
	for py in python3 python3.13 python3.12 python3.11; do
		if "$py" -I -c 'import tomllib' 2>/dev/null; then
			"$py" -I "$zen_git/release-fits.py" "$1" "$2" "$3"
			return
		fi
	done
	if command -v uv >/dev/null 2>&1; then
		uv run --no-project --no-python-downloads --python '>=3.11' python -I "$zen_git/release-fits.py" "$1" "$2" "$3"
		return
	fi
	zen_say "no python >= 3.11 or uv to parse $3"
	return 1
}

# zen-release consumes its approval before it merges and bumps; the inbox
# then lets exactly one push through on it (approval push, after the repo's
# hook). Nothing in the repo is trusted.
releases=""
pending=""
while read -r class branch lsha rsha; do
	[ -n "$branch" ] || continue
	id=""
	if { [ "$class" = create ] || [ "$class" = update ]; } &&
		inbox approval pending --repo "$repo" --branch "$branch"; then
		while read -r p_id p_sha; do
			[ ${#p_sha} = 40 ] && [ -z "${p_sha//[0-9a-f]/}" ] || continue
			if release_fits "$p_sha" "$lsha" "$rsha"; then
				id=$p_id
				break
			fi
		done <<<"$out"
	fi
	if [ -n "$id" ]; then
		releases="$releases$id $branch $lsha
"
	else
		pending="$pending$class $branch $lsha $rsha
"
	fi
done <<EOF
$gated
EOF
gated=$pending

tty=${ZEN_PREPUSH_TTY:-/dev/tty}
human=""
if [ -n "$gated" ] && ! reason=$(agent_reason) && { : <"$tty"; } 2>/dev/null; then
	human=1
fi

confirmed=""
approve=""
while read -r class branch lsha rsha; do
	[ -n "$branch" ] || continue
	if [ -n "$human" ] && { [ "$class" = create ] || [ "$class" = update ]; }; then
		confirmed="$confirmed$branch $lsha
"
	else
		approve="$approve$class $branch $lsha $rsha
"
	fi
done <<EOF
$gated
EOF

if [ -n "$approve" ]; then
	[ -n "$human" ] || zen_say "agent push: ${reason:-no tty to confirm on}"
	failed=""
	while read -r class branch lsha rsha; do
		[ -n "$branch" ] || continue
		rc=0
		inbox approval check --match --action push --repo "$repo" --branch "$branch" --sha "$lsha" || rc=$?
		if [ "$rc" = 5 ]; then
			refuse "$out; $bypass"
		elif [ "$rc" != 0 ]; then
			zen_say "refused $class of $branch: $out"
			ask_line "$class" "$branch" "$lsha" "$rsha"
			failed=1
		fi
	done <<EOF
$approve
EOF
	[ -z "$failed" ] || refuse "file the ask above, wait for Approve in the panel, then push again"
fi

if [ -n "$confirmed" ]; then
	command -v gum >/dev/null 2>&1 || refuse "gum not found to confirm the push; $bypass"
	while read -r branch sha; do
		[ -n "$branch" ] || continue
		# shellcheck disable=SC2094 # the tty is the prompt's input and output
		gum confirm --default=false "Push $repo $branch@${sha:0:12} without an inbox approval?" <"$tty" >"$tty" 2>&1 ||
			refuse "push to $branch cancelled"
	done <<EOF
$confirmed
EOF
fi

repo_hook "$@"
while read -r id branch lsha; do
	[ -n "$branch" ] || continue
	inbox approval push "$id" --repo "$repo" --branch "$branch" --sha "$lsha" ||
		refuse "refused release push of $branch: $out"
	zen_say "${out##*$'\n'}"
done <<EOF
$releases
EOF
while read -r class branch lsha _; do
	[ -n "$branch" ] || continue
	inbox approval use --match --action push --repo "$repo" --branch "$branch" --sha "$lsha" ||
		refuse "refused $class of $branch: $out"
	zen_say "$out"
done <<EOF
$approve
EOF
