#!/bin/bash
# Scans the pushed commits for secrets first (git/secret-scan.sh), then gates
# every push to prod/main/master: an agent push, a force push or a delete needs
# an approved, unused `zen-inbox ask --prod push` for that repo, branch and
# sha; a human at a tty confirms a plain create or update with gum. The repo's
# own pre-push runs before the consume, so its failure leaves the approval
# unused. A guard rail, not a boundary: --no-verify skips it.
# Known limit: git push --dry-run runs this hook too, so it consumes.
set -e

zen_say() { echo "pre-push: $*" >&2; }

input=$(
	cat
	echo .
)
input=${input%.}

common=$(git rev-parse --path-format=absolute --git-common-dir)
repo=$(basename "$(dirname "$common")")
bypass="run it yourself with git push --no-verify"

refuse() {
	zen_say "$*"
	exit 1
}

hook="$common/hooks/pre-push"
repo_hook() {
	if [ -x "$hook" ] && ! [ "$hook" -ef "$0" ]; then
		"$hook" "$@" < <(printf '%s' "$input")
	fi
}

# $1 class, $2 branch, $3 local sha, $4 remote sha
ask_line() {
	local context=""
	case $1 in
	force) context=" --context \"force push over ${4:0:12}\"" ;;
	delete) context=" --context \"delete $2 at ${4:0:12}\"" ;;
	esac
	echo "  zen-inbox ask <task> --prod push --repo $repo --branch $2 --sha $3$context" >&2
}

zero() { [ -z "${1//0/}" ]; }

src=$0
while [ -L "$src" ]; do
	link=$(readlink "$src")
	case $link in
	/*) src=$link ;;
	*) src=$(dirname "$src")/$link ;;
	esac
done
zen_git=$(cd -P "$(dirname "$src")/.." && pwd)
# shellcheck source=git/secret-scan.sh
. "$zen_git/secret-scan.sh"
secret_scan "$@"

# Runs zen-inbox into $out; returns 0, 1, or 5 when it is missing or failed
# for any other reason (go, vault or db unavailable).
inbox() {
	if ! command -v zen-inbox >/dev/null 2>&1; then
		out="zen-inbox not found on PATH"
		return 5
	fi
	local rc=0
	out=$(zen-inbox "$@" 2>&1) || rc=$?
	case $rc in
	0 | 1) return $rc ;;
	*)
		out="zen-inbox exited $rc: $out"
		return 5
		;;
	esac
}

# Same rule as zen-inbox's guard: a path segment names the agent, also as a
# runtime's script; the agent-manager tmux server (-L agentmgr) counts too.
agent_in() {
	local exe f fields
	read -ra fields <<<"$1"
	[ ${#fields[@]} -gt 0 ] || return 1
	exe=${fields[0]#-}
	case ${exe##*/} in
	node | bun | deno) fields=("$exe" "${fields[@]:1}") ;;
	tmux)
		for f in "${fields[@]}"; do
			case $f in -Lagentmgr) return 0 ;; esac
		done
		case " ${fields[*]} " in *" -L agentmgr "*) return 0 ;; esac
		fields=("$exe")
		;;
	*) fields=("$exe") ;;
	esac
	for f in "${fields[@]}"; do
		case /$f/ in
		*/claude/* | */claude-code/* | */codex/*) return 0 ;;
		esac
	done
	return 1
}

# Prints why this push comes from an agent: an agent env var, or an agent in
# the process tree, which survives an unset env. Fails closed.
agent_reason() {
	local v pid=$$ depth=0 line ppid args
	for v in AGENT_MANAGER_SESSION_ID AGENT_MANAGER_AGENT_PID CLAUDECODE; do
		if [ -n "${!v}" ]; then
			echo "$v is set"
			return 0
		fi
	done
	while [ "$pid" -gt 1 ]; do
		if [ $((depth += 1)) -gt 256 ]; then
			echo "process tree deeper than 256"
			return 0
		fi
		if ! line=$(ps -o ppid=,args= -p "$pid" 2>/dev/null) || [ -z "$line" ]; then
			echo "process tree unreadable at pid $pid"
			return 0
		fi
		read -r ppid args <<<"$line"
		case $ppid in
		'' | *[!0-9]*)
			echo "process tree unreadable at pid $pid"
			return 0
			;;
		esac
		if agent_in "$args"; then
			echo "inside ${args%% *} (pid $pid)"
			return 0
		fi
		pid=$ppid
	done
	return 1
}

# One line per gated ref: class branch local-sha remote-sha, where class is
# create, update, force (remote sha not an ancestor, or unknown here) or delete.
gated=""
while read -r _ lsha rref rsha; do
	case $rref in
	refs/heads/prod | refs/heads/main | refs/heads/master) ;;
	*) continue ;;
	esac
	[ "$lsha" = "$rsha" ] && continue
	if zero "$lsha"; then
		class=delete
	elif zero "$rsha"; then
		class=create
	elif git merge-base --is-ancestor "$rsha" "$lsha^{commit}" 2>/dev/null; then
		class=update
	else
		class=force
	fi
	gated="$gated$class ${rref#refs/heads/} $lsha $rsha
"
done <<EOF
$input
EOF

[ -n "$gated" ] || {
	repo_hook "$@"
	exit 0
}

# zen-release writes "<approval id> <branch> <sha>" here just before its push.
# The token is single use, and the ledger binds each approval to the first sha
# it let through, so a token replayed for another sha fails.
token=$common/zen-release-token
ledger=$common/zen-release-ledger
if [ -f "$token" ]; then
	read -r t_id t_branch t_sha <"$token" || true
	rm -f "$token"
	pending=""
	while read -r class branch lsha rsha; do
		[ -n "$branch" ] || continue
		if [ -n "$t_id" ] && [ "$branch" = "$t_branch" ] && [ "$lsha" = "$t_sha" ] &&
			{ [ "$class" = create ] || [ "$class" = update ]; }; then
			prior=$(awk -v id="$t_id" '$1 == id { print $2; exit }' "$ledger" 2>/dev/null || true)
			if [ -n "$prior" ] && [ "$prior" != "$lsha" ]; then
				zen_say "release token $t_id already pushed ${prior:0:12}; checking $branch as a plain push"
			elif inbox approval used "$t_id" --action release --repo "$repo" --branch "$branch" &&
				git merge-base --is-ancestor "${out##*$'\n'}" "$lsha" 2>/dev/null; then
				[ -n "$prior" ] || echo "$t_id $lsha" >>"$ledger"
				continue
			fi
		fi
		pending="$pending$class $branch $lsha $rsha
"
	done <<EOF
$gated
EOF
	gated=$pending
fi

tty=${ZEN_PREPUSH_TTY:-/dev/tty}
human=""
if ! reason=$(agent_reason) && { : <"$tty"; } 2>/dev/null; then
	human=1
fi

confirmed=""
approve=""
while read -r class branch lsha rsha; do
	[ -n "$branch" ] || continue
	if [ -n "$human" ] && { [ "$class" = create ] || [ "$class" = update ]; }; then
		confirmed="$confirmed$branch $lsha
"
	else
		approve="$approve$class $branch $lsha $rsha
"
	fi
done <<EOF
$gated
EOF

if [ -n "$approve" ]; then
	[ -n "$human" ] || zen_say "agent push: ${reason:-no tty to confirm on}"
	failed=""
	while read -r class branch lsha rsha; do
		[ -n "$branch" ] || continue
		rc=0
		inbox approval check --match --action push --repo "$repo" --branch "$branch" --sha "$lsha" || rc=$?
		if [ "$rc" = 5 ]; then
			refuse "$out; $bypass"
		elif [ "$rc" != 0 ]; then
			zen_say "refused $class of $branch: $out"
			ask_line "$class" "$branch" "$lsha" "$rsha"
			failed=1
		fi
	done <<EOF
$approve
EOF
	[ -z "$failed" ] || refuse "file the ask above, wait for Approve in the panel, then push again"
fi

if [ -n "$confirmed" ]; then
	command -v gum >/dev/null 2>&1 || refuse "gum not found to confirm the push; $bypass"
	while read -r branch sha; do
		[ -n "$branch" ] || continue
		# shellcheck disable=SC2094 # the tty is the prompt's input and output
		gum confirm --default=false "Push $repo $branch@${sha:0:12} without an inbox approval?" <"$tty" >"$tty" 2>&1 ||
			refuse "push to $branch cancelled"
	done <<EOF
$confirmed
EOF
fi

repo_hook "$@"
while read -r class branch lsha _; do
	[ -n "$branch" ] || continue
	inbox approval use --match --action push --repo "$repo" --branch "$branch" --sha "$lsha" ||
		refuse "refused $class of $branch: $out"
	zen_say "$out"
done <<EOF
$approve
EOF
