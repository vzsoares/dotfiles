#!/usr/bin/env bash

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_CLAUDE="$SCRIPT_DIR/.claude"
TARGET_DIR="$HOME/.claude"

# CLAUDE.md
rm -f "$TARGET_DIR/CLAUDE.md"
ln -s "$DOTFILES_CLAUDE/CLAUDE.md" "$TARGET_DIR/CLAUDE.md"
echo "linked CLAUDE.md"

# Settings
rm -f "$TARGET_DIR/settings.json"
ln -s "$DOTFILES_CLAUDE/settings.json" "$TARGET_DIR/settings.json"
echo "linked settings.json"

# Skills
rm -rf "$TARGET_DIR/skills"
ln -s "$DOTFILES_CLAUDE/skills" "$TARGET_DIR/skills"
echo "linked skills/"

# Output styles
rm -rf "$TARGET_DIR/output-styles"
ln -s "$DOTFILES_CLAUDE/output-styles" "$TARGET_DIR/output-styles"
echo "linked output-styles/"

# Subagents
if [ -d "$TARGET_DIR/agents" ] && [ ! -L "$TARGET_DIR/agents" ]; then
  mv "$TARGET_DIR/agents" "$TARGET_DIR/agents.bak.$(date +%s)"
fi
rm -f "$TARGET_DIR/agents"
ln -s "$DOTFILES_CLAUDE/agents" "$TARGET_DIR/agents"
echo "linked agents/"

# Statusline command
rm -f "$TARGET_DIR/statusline-command.sh"
ln -s "$DOTFILES_CLAUDE/statusline-command.sh" "$TARGET_DIR/statusline-command.sh"
echo "linked statusline-command.sh"

# MCP servers: mcp/servers.json is the source; Claude keeps user-scope servers
# in ~/.claude.json, so each one is re-registered there.
MCP_SERVERS="$SCRIPT_DIR/mcp/servers.json"
if command -v claude >/dev/null && command -v jq >/dev/null; then
  # Claude stores an empty env as {}; drop it so unchanged entries compare equal.
  # shellcheck disable=SC2016
  norm='.mcpServers[$n] | select(. != null) | if .env == {} then del(.env) else . end'
  for name in $(jq -r '.mcpServers | keys[]' "$MCP_SERVERS"); do
    want="$(jq -cS --arg n "$name" "$norm" "$MCP_SERVERS")"
    have="$(jq -cS --arg n "$name" "$norm" "$HOME/.claude.json" 2>/dev/null || true)"
    if [ "$want" = "$have" ]; then
      echo "mcp $name unchanged"
      continue
    fi
    if [ -n "$have" ]; then
      claude mcp remove -s user "$name" >/dev/null || true
    fi
    claude mcp add-json -s user "$name" "$want" ||
      echo "warning: failed to register MCP server $name" >&2
  done
else
  echo "warning: claude or jq missing; skipped MCP servers" >&2
fi

echo "done"
