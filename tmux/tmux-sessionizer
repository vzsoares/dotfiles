#!/usr/bin/env bash

if [[ $# -eq 1 ]]; then
    selected=$1
else
    shopt -s nullglob
    roots=("$HOME" "$HOME/code" "$HOME"/code/*/ "$HOME/code/tests" "$HOME/code/personal"
        "$HOME/code/extraneous" "$HOME/code/approva" "$HOME/code/approva/utils"
        "$HOME/code/approva/back" "$HOME/code/approva/layers" "$HOME/code/approva/front"
        "$HOME/code/approva/automation" "$HOME/Downloads")
    existing=()
    for r in "${roots[@]}"; do
        [[ -d $r ]] && existing+=("${r%/}")
    done
    selected=$(find "${existing[@]}" -mindepth 1 -maxdepth 1 -type d | awk '!seen[$0]++' | fzf)
fi

if [[ -z $selected ]]; then
    exit 0
fi

selected_name=$(basename "$selected" | tr . _)
tmux_running=$(pgrep tmux)

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    tmux new-session -s $selected_name -c $selected
    exit 0
fi

if ! tmux has-session -t=$selected_name 2>/dev/null; then
    tmux new-session -ds $selected_name -c $selected
fi

tmux switch-client -t $selected_name
