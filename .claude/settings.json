{
  "permissions": {
    "additionalDirectories": [
      "/home/zizmackrok/code"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "notify-send 'Claude Code' 'Claude Code needs your attention'; zen-bell window-attention",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "zen-bell complete",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": []
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/skills/clawd-status/scripts/statusline.sh",
    "refreshInterval": 1
  },
  "enabledPlugins": {},
  "skillOverrides": {
    "auto-mode-setup": "off"
  },
  "tui": "default",
  "skipDangerousModePermissionPrompt": false,
  "skipWorkflowUsageWarning": true,
  "editorMode": "vim",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--output-dir",
        "/tmp/playwright-mcp"
      ]
    },
    "docs-mcp-server": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@arabold/docs-mcp-server@latest"
      ],
      "env": {
        "OPENAI_API_KEY": "ollama",
        "OPENAI_API_BASE": "http://localhost:11434/v1",
        "DOCS_MCP_EMBEDDING_MODEL": "openai:nomic-embed-text"
      }
    }
  },
  "autoCompactWindow": 800000
}
