{
    "mcpServers": {
        "playwright": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "-y",
                "@playwright/mcp@latest",
                "--output-dir",
                "/tmp/playwright-mcp"
            ]
        },
        "qmd": {
            "type": "stdio",
            "command": "qmd",
            "args": ["mcp"]
        }
    }
}
